# Configure both values to enable Supabase persistence. Leave both blank for SQLite.
SUPABASE_URL=
SUPABASE_KEY=

# Optional override; defaults to traceguard/defense_engine.db.
TRACEGUARD_DB=
# Optional evidence package override.
TRACEGUARD_EVIDENCE=

# Request-time bank-change gate. Leave blank to keep it disabled (fail closed).
# Store only SHA-256 hashes of caller tokens in this JSON; never commit live secrets.
ORBIT_GATE_CREDENTIALS_JSON=
# Generate with Fernet.generate_key(); keep in a server-side secrets manager.
ORBIT_DATA_ENCRYPTION_KEY=
# Generate at least 32 random bytes; used for keyed bank-detail fingerprints.
ORBIT_BANK_FIELD_HMAC_KEY=
# Finance connector: use "generic" for the existing PATCH adapter or "qbo" for
# the fixed Intuit QuickBooks Online sandbox adapter. QBO never targets production.
ORBIT_FINANCE_PROVIDER=generic
ORBIT_FINANCE_API_BASE_URL=
ORBIT_FINANCE_API_TOKEN=
# QBO OAuth values are obtained from an Intuit developer app authorized against
# its sandbox company. Keep all values server-side; never commit these secrets.
ORBIT_QBO_REALM_ID=
ORBIT_QBO_CLIENT_ID=
ORBIT_QBO_CLIENT_SECRET=
ORBIT_QBO_REFRESH_TOKEN=
# Optional mapping from Orbit case vendor IDs to QBO sandbox Vendor IDs.
ORBIT_QBO_VENDOR_ID_MAP_JSON=
# Zoho Books India (requires an India-DC OAuth access token and numeric contact IDs).
ORBIT_ZOHO_ORGANIZATION_ID=
ORBIT_ZOHO_ACCESS_TOKEN=
ORBIT_ZOHO_VENDOR_ID_MAP_JSON=
# Optional; defaults to https://www.zohoapis.in/books/v3
ORBIT_ZOHO_API_BASE=https://www.zohoapis.in/books/v3
